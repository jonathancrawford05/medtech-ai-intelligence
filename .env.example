# Copy to .env and adjust. All settings are optional; these are the defaults.
# See src/registry/config/settings.py for the full list.

REGISTRY_LAKEHOUSE_ROOT=./lakehouse
REGISTRY_STORAGE_MODE=path

REGISTRY_SPARK_MASTER=local[*]
REGISTRY_SPARK_DRIVER_MEMORY=4g

# openFDA works without a key at a lower rate limit.
# REGISTRY_OPENFDA_API_KEY=

# --- Databricks migration: the only two lines that need to change ---
# REGISTRY_STORAGE_MODE=catalog
# REGISTRY_LAKEHOUSE_ROOT=main.registry
